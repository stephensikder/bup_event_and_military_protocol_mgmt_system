# =====================================================================
# BUP Event & Military Protocol Management System - Production Template
# =====================================================================

# MongoDB Atlas Connection URI (Required on Render)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bup_event_protocol?retryWrites=true&w=majority"

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
BASE_URL=

# PHPMailer SMTP Settings (Optional on Render)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="BUP Event & Military Protocol Management System"
